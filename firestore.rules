rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // v5.2.8: learners who are not logged in have a Firebase Anonymous Auth uid.
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function validXp(x) { return x is int && x >= 0 && x < 100000000; }

    // Role / moderation state lives in roles/{uid} and can only be written by admins.
    function roleDoc(uid) { return get(/databases/$(database)/documents/roles/$(uid)).data; }
    function hasRole(uid) { return exists(/databases/$(database)/documents/roles/$(uid)); }
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email == 'virusphuoc@gmail.com' && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isOwnerEmail() || (signedIn() && hasRole(request.auth.uid) && roleDoc(request.auth.uid).get('role', 'user') == 'admin');
    }
    function notLocked(uid) { return !hasRole(uid) || roleDoc(uid).get('locked', false) != true; }
    function notHidden(uid) { return !hasRole(uid) || roleDoc(uid).get('hidden', false) != true; }
    function nameAllowed(uid, n) {
      return validName(n) && (!hasRole(uid) || roleDoc(uid).get('forcedName', '') == '' || roleDoc(uid).get('forcedName', '') == n);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && !isAnon() && notLocked(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'lastActive', 'progress', 'updatedAt', 'clientId'])
        && request.resource.data.progress is map;
    }

    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'email', 'locked', 'hidden', 'forcedName', 'revoked', 'updatedAt', 'vipUntil', 'vipBy']);
      allow delete: if isAdmin();
    }

    // ---------- v5.2.8: one public board for accounts and anonymous learners ----------
    // Anyone reads; only the owner of the uid writes its document. Anonymous learners (Firebase Anonymous Auth) must be
    // marked `anon: true` and carry the join number `no` taken from site/anonCounter; accounts may not carry either.
    function anonCounter() { return /databases/$(database)/documents/site/anonCounter; }
    function boardEntry(uid, d) {
      return isOwner(uid) && notLocked(uid) && notHidden(uid)
        && nameAllowed(uid, d.displayName) && validXp(d.xp) && d.updatedAt is number
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level < 100000))
        && (isAnon() ? d.anon == true && d.displayName.size() <= 30 : !('anon' in d) && !('no' in d));
    }

    match /leaderboard/{uid} {
      allow read: if true;
      // New entry: an anonymous learner's number must be the one the counter reaches in the same transaction.
      allow create: if request.resource.data.keys().hasOnly(['displayName', 'xp', 'level', 'updatedAt', 'anon', 'no'])
        && boardEntry(uid, request.resource.data)
        && (!isAnon() || (request.resource.data.no is int && request.resource.data.no == getAfter(anonCounter()).data.count
            && (!exists(anonCounter()) || get(anonCounter()).data.count == request.resource.data.no - 1)));
      // Later writes keep the number. After linking to a real account the anonymous marks are dropped.
      allow update: if request.resource.data.keys().hasOnly(['displayName', 'xp', 'level', 'updatedAt', 'anon', 'no'])
        && boardEntry(uid, request.resource.data)
        && (!isAnon() || request.resource.data.no == resource.data.no);
      allow update: if isAdmin() && validName(request.resource.data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /weeks/{weekId}/entries/{uid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['displayName', 'xp', 'updatedAt', 'anon'])
        && boardEntry(uid, request.resource.data);
      allow update: if isAdmin() && validName(request.resource.data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // site/announcement: the "what's new" notice. Everyone reads, only admins write.
    // site/anonCounter: { count } = number of anonymous learners so far. It only moves up by exactly 1, and only in the
    // same transaction in which the caller creates its own leaderboard entry with that number.
    match /site/{id} {
      allow read: if true;
      allow write: if id != 'anonCounter' && isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'version', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 1500
        && request.resource.data.version is string && request.resource.data.version.size() <= 20;
      allow delete: if id != 'anonCounter' && isAdmin();
      allow create: if id == 'anonCounter' && isAnon()
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1
        && !exists(/databases/$(database)/documents/leaderboard/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/leaderboard/$(request.auth.uid)).data.no == 1;
      allow update: if id == 'anonCounter' && isAnon()
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1
        && !exists(/databases/$(database)/documents/leaderboard/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/leaderboard/$(request.auth.uid)).data.no == request.resource.data.count;
    }

    // Admin-managed course content (falls back to the bundled lessons when empty).
    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /units/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- v5.1: anonymous visit statistics (admin screen "Thống kê truy cập") ----------
    // Counters: stats/visits (all time) and stats/day-YYYY-MM-DD. Anyone, signed in or not, may add exactly 1; only admins read.
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if (id == 'visits' || id.matches('^day-[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }
    // Presence heartbeat: presence/{random client id} = { at: <ms> }, sent about once a minute. Only admins read (count).
    match /presence/{clientId} {
      allow read, delete: if isAdmin();
      allow create, update: if clientId.matches('^[a-z0-9]{12}$')
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 600000;
    }

    // ---------- v4: friends + 1-to-1 chat (text and emoji only) ----------
    function me() { return request.auth.uid; }
    function path(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    function isFriendPair(pairId) { return exists(path('friendships', pairId)); }
    function pairOf(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function blockedBy(by, target) { return exists(path('blocks', by + '_' + target)); }
    // users: [a, b] sorted, document id "a_b", and the caller is one of the two
    function validPair(pairId, users) {
      return users is list && users.size() == 2 && users[0] is string && users[1] is string
        && users[0] < users[1] && pairId == users[0] + '_' + users[1] && me() in users;
    }
    function otherOf(users) { return users[0] == me() ? users[1] : users[0]; }
    function validText(t) { return t is string && t.size() > 0 && t.size() <= 1000; }
    function isReported(chatId, msgId) { return exists(path('reports', chatId + '_' + msgId)); }

    // Public name used to find people. Only the owner writes it; any signed-in user can read it.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && notLocked(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'nameLower', 'updatedAt'])
        && nameAllowed(userId, request.resource.data.displayName)
        && request.resource.data.nameLower == request.resource.data.displayName.lower();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Pending friend request, id "<from>_<to>". Visible to the two people only.
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && notLocked(me())
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'createdAt'])
        && request.resource.data.from == me()
        && request.resource.data.to is string && request.resource.data.to != me()
        && id == me() + '_' + request.resource.data.to
        && validName(request.resource.data.fromName) && validName(request.resource.data.toName)
        && request.resource.data.createdAt is int
        && exists(path('profiles', request.resource.data.to))
        && !blockedBy(request.resource.data.to, me()) && !blockedBy(me(), request.resource.data.to)
        && !isFriendPair(pairOf(me(), request.resource.data.to));
      // the receiver declines, the sender cancels
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    // A friendship exists only after the receiver accepted a request. Either friend can end it.
    match /friendships/{pairId} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn() && notLocked(me())
        && request.resource.data.keys().hasOnly(['users', 'names', 'createdAt'])
        && validPair(pairId, request.resource.data.users)
        && request.resource.data.names is map && request.resource.data.createdAt is int
        && exists(path('friendRequests', otherOf(request.resource.data.users) + '_' + me()))
        && !blockedBy(me(), otherOf(request.resource.data.users));
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // Block list, id "<by>_<target>". Only the blocker sees and manages it.
    match /blocks/{id} {
      allow read: if signedIn() && resource.data.by == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'target', 'targetName', 'createdAt'])
        && request.resource.data.by == me()
        && request.resource.data.target is string && request.resource.data.target != me()
        && id == me() + '_' + request.resource.data.target;
      allow delete: if signedIn() && resource.data.by == me();
    }

    // Chat between two friends: ONLY the two participants can read or write it.
    match /chats/{pairId} {
      allow read: if signedIn() && me() in resource.data.users;
      allow create: if signedIn() && notLocked(me())
        && request.resource.data.keys().hasOnly(['users', 'lastText', 'lastAt', 'lastFrom', 'unread'])
        && validPair(pairId, request.resource.data.users)
        && isFriendPair(pairId);
      allow update: if signedIn() && notLocked(me()) && me() in resource.data.users
        && request.resource.data.keys().hasOnly(['users', 'lastText', 'lastAt', 'lastFrom', 'unread'])
        && request.resource.data.users == resource.data.users;

      match /messages/{msgId} {
        // participants; an admin can read a message only once it has been reported
        allow read: if signedIn()
          && (me() in get(path('chats', pairId)).data.users || (isAdmin() && isReported(pairId, msgId)));
        // strangers cannot message: the two must be friends right now
        allow create: if signedIn() && notLocked(me())
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.from == me()
          && validText(request.resource.data.text) && request.resource.data.at is int
          && isFriendPair(pairId) && me() in get(path('friendships', pairId)).data.users;
        // moderation: an admin can hide (blank) a reported message, nothing else
        allow update: if isAdmin() && isReported(pairId, msgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'text'])
          && request.resource.data.hidden == true && request.resource.data.text == '';
        // only the sender can delete their own message
        allow delete: if signedIn() && resource.data.from == me();
      }
    }

    // Copy of a reported message for the admin page, id "<chatId>_<msgId>".
    match /reports/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && notLocked(me())
        && request.resource.data.keys().hasOnly(['chatId', 'msgId', 'from', 'fromName', 'text', 'at', 'reporter', 'reporterName', 'reason', 'createdAt', 'status'])
        && request.resource.data.reporter == me()
        && id == request.resource.data.chatId + '_' + request.resource.data.msgId
        && me() in get(path('chats', request.resource.data.chatId)).data.users
        // the copy must match the real message, and you cannot report yourself
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.msgId)).data.from == request.resource.data.from
        && get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)/messages/$(request.resource.data.msgId)).data.text == request.resource.data.text
        && request.resource.data.from != me()
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']);
    }
  }
}
