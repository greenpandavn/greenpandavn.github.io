rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    function validXp(x) { return x is int && x >= 0 && x < 100000000; }

    // Role / moderation state lives in roles/{uid} and can only be written by admins.
    function roleDoc(uid) { return get(/databases/$(database)/documents/roles/$(uid)).data; }
    function hasRole(uid) { return exists(/databases/$(database)/documents/roles/$(uid)); }
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email == 'virusphuoc@gmail.com' && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isOwnerEmail() || (signedIn() && hasRole(request.auth.uid) && roleDoc(request.auth.uid).get('role', 'user') == 'admin');
    }
    function notLocked(uid) { return !hasRole(uid) || roleDoc(uid).get('locked', false) != true; }
    function notHidden(uid) { return !hasRole(uid) || roleDoc(uid).get('hidden', false) != true; }
    function nameAllowed(uid, n) {
      return validName(n) && (!hasRole(uid) || roleDoc(uid).get('forcedName', '') == '' || roleDoc(uid).get('forcedName', '') == n);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && notLocked(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'lastActive', 'progress', 'updatedAt', 'clientId'])
        && request.resource.data.progress is map;
    }

    match /roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'email', 'locked', 'hidden', 'forcedName', 'revoked', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && notLocked(uid) && notHidden(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'xp', 'updatedAt'])
        && nameAllowed(uid, request.resource.data.displayName)
        && validXp(request.resource.data.xp);
      allow update: if isAdmin() && validName(request.resource.data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /weeks/{weekId}/entries/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && notLocked(uid) && notHidden(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'xp', 'updatedAt'])
        && nameAllowed(uid, request.resource.data.displayName)
        && validXp(request.resource.data.xp);
      allow update: if isAdmin() && validName(request.resource.data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Admin-managed course content (falls back to the bundled lessons when empty).
    match /lessons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /units/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
